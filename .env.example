# 应用
APP_ENV=prod
APP_PORT=3100
TIMEZONE=Asia/Shanghai

# 数据库（默认 SQLite）
DB_DRIVER=sqlite
DB_NAME=storage/experience.db

# 日志
LOG_LEVEL=info
LOG_TYPE=json

# 向量嵌入（必填）
EMBEDDING_PROVIDER=zhipu
EMBEDDING_API_KEY=<your-api-key>
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048

# 认证
AUTH_TOTP_SECRET=<base32-secret>
AUTH_SESSION_TTL=24h

# API 代理（可选，将 Anthropic Messages API 转为 OpenAI Chat Completions API）
PROXY_ENABLED=false
PROXY_BASE_URL=https://api.openai.com/v1
PROXY_API_KEY=<your-api-key>
PROXY_MODEL_MAP={"claude-sonnet-4-20250514":"gpt-4o","claude-haiku-4-5-20251001":"gpt-4o-mini"}
